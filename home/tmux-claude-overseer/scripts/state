#!/usr/bin/env bash
# Stamp the current tmux pane with the running Claude session's state, so the
# status-bar badge and the picker can surface it. Invoked from Claude Code
# hooks (see programs.claude-code.settings.hooks in home/default.nix).
#
# Usage: state <working|needs_input|clear>
#
# Hooks pass event JSON on stdin; we ignore it — $TMUX_PANE is all we need.
# Always exits 0: a hook must never block Claude.

state="${1:-}"
[ -n "$state" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0   # not inside tmux -> nothing to do

if [ "$state" = "clear" ]; then
  tmux set-option -pu -t "$TMUX_PANE" @claude_state 2>/dev/null || true
else
  tmux set-option -p -t "$TMUX_PANE" @claude_state "$state" 2>/dev/null || true
fi

tmux refresh-client -S 2>/dev/null || true
exit 0

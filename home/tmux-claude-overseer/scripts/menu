#!/usr/bin/env bash
# Picker: list every pane running Claude with its state + session title,
# preview what each one is doing, fuzzy-pick one and jump to it.
# Run inside `tmux display-popup -E` (bound to M-i by claude-overseer.tmux).
set -uo pipefail

# Per-pane: state <TAB> sess:win.pane <TAB> pane_title <TAB> pane_current_path <TAB> pane_id
fmt=$'#{@claude_state}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_title}\t#{pane_current_path}\t#{pane_id}'

rows=$(tmux list-panes -a -F "$fmt" 2>/dev/null | awk -F'\t' '$1 != ""')

if [ -z "$rows" ]; then
  echo "No Claude sessions tracked."
  sleep 1
  exit 0
fi

# Catppuccin mocha icon colours (truecolor; fzf renders them via --ansi).
c_wait=$'\033[38;2;250;179;135m'  # peach — needs_input
c_work=$'\033[38;2;166;227;161m'  # green — working
c_rst=$'\033[0m'

# Build "<sortkey>\t<icon>  <loc>  <title>  <path>\t<pane_id>", sort needs_input
# to the top, drop the sortkey, then let fzf show field 1 (pane_id stays hidden).
# Claude prefixes its title with a spinner glyph (e.g. "⠂ ") — strip it.
choice=$(printf '%s\n' "$rows" | awk -F'\t' -v cw="$c_wait" -v ck="$c_work" -v cr="$c_rst" '{
    if ($1 == "needs_input")   { icon = cw "◐" cr; key = 0 }
    else if ($1 == "working")  { icon = ck "●" cr; key = 1 }
    else                       { icon = "○";       key = 2 }
    title = $3
    sub(/^[^[:alnum:]]+[[:space:]]*/, "", title)
    if (title == "") title = "(claude)"
    printf "%d\t%s  %-9s  %-28s  %s\t%s\n", key, icon, $2, title, $4, $5
  }' | sort -t "$(printf '\t')" -k1,1n -s | cut -f2- | \
  fzf --ansi --reverse --delimiter='\t' --with-nth=1 \
    --prompt='claude ❯ ' \
    --preview='tmux capture-pane -pet {2}' \
    --preview-window='right:55%:wrap:follow') || exit 0

pane_id=${choice##*$'\t'}
[ -n "$pane_id" ] || exit 0

tmux switch-client -t "$pane_id" 2>/dev/null || true
tmux select-window -t "$pane_id" 2>/dev/null || true
tmux select-pane   -t "$pane_id" 2>/dev/null || true

#!/usr/bin/env bash
# Status-bar segment: a catppuccin-styled bubble showing how many Claude panes
# are waiting on the user. Emits nothing when none are waiting (quiet when idle).
# Place it in your status-right via #(...); must stay cheap and never error out.
#
# The bubble mirrors catppuccin's own right-side module structure
# (see <catppuccin>/utils/status_module.conf):
#   [fg=icon_bg]<left-sep>[crust on icon_bg]<icon>[fg on surface0]<text>[fg=surface0]<sp>
# Colours are the catppuccin *mocha* palette, matching @catppuccin_flavour in
# home/default.nix. If that flavour changes, update these hexes (or read them
# from `tmux show -gv @thm_*`).

count=$(tmux list-panes -a -F '#{@claude_state}' 2>/dev/null | grep -c '^needs_input$')
[ "${count:-0}" -gt 0 ] || exit 0

peach="#fab387"    # @thm_peach     — icon background (attention)
crust="#11111b"    # @thm_crust     — icon foreground
surface0="#313244" # @thm_surface_0 — text background
fg="#cdd6f4"       # @thm_fg        — text foreground
lsep=$''     # @catppuccin_status_left_separator (rounded left, U+E0B6)
icon=$'\U000f06a9 ' # nerd-font robot (md-robot, U+F06A9) + trailing space, matching catppuccin icons

printf '#[fg=%s]%s#[fg=%s,bg=%s]%s#[fg=%s,bg=%s] %s#[fg=%s] ' \
  "$peach" "$lsep" \
  "$crust" "$peach" "$icon" \
  "$fg" "$surface0" "$count" \
  "$surface0"
